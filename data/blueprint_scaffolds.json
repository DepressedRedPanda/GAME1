{
  "_about": "Blueprint scaffolds for GAME1, read by Scripts/create_blueprint_scaffolds.py (in Unreal) and Scripts/validate_repo.py (in CI). Names follow docs/UNIFIED_GAME_ARCHITECTURE.md. 'owner' = the one system this Blueprint is responsible for; the validator refuses two Blueprints owning the same system. A default of {\"balance\": \"a.b\"} is read from data/balance.json.",
  "root": "/Game/HeavyMettle/Blueprints",
  "scaffolds": [
    {
      "name": "BPI_HM_Interactable",
      "owner": "interaction",
      "kind": "interface",
      "functions": [
        "Interact",
        "CanInteract",
        "GetInteractPrompt"
      ],
      "manual": [
        "Open BPI_HM_Interactable. Select Interact: add Input 'Interactor' (Actor > Object Reference).",
        "Select CanInteract: add Input 'Interactor' (Actor) and Output 'bCanInteract' (Boolean).",
        "Select GetInteractPrompt: add Output 'Prompt' (Text). Compile, Save."
      ]
    },
    {
      "name": "BP_HM_GameMode",
      "owner": "game_mode",
      "parent": "template:GameMode",
      "fallback_parent": "engine:GameModeBase",
      "manual": [
        "Components panel > Add > BP_HM_SaveManager.",
        "Only use this GameMode in World Settings once BP_HM_Android spawns and moves in PIE."
      ]
    },
